# DigitalOcean / Docker Compose example. Never commit a real .env file.
# deploy/install-ubuntu.sh replaces these two generated placeholders.
POSTGRES_PASSWORD=GENERATE_ME
DATABASE_URL=postgresql+asyncpg://steamsell:GENERATE_ME@db:5432/steamsell
REDIS_URL=redis://redis:6379/0

# Telegram
BOT_TOKEN=
ADMIN_ID=
ADMIN_IDS=
SUPPORT_USERNAME=

# Keep this key unchanged when restoring an existing database.
ENCRYPTION_KEY=GENERATE_ME

# Payments
MONO_TOKEN=
MANUAL_CARD=

# Public HTTPS endpoint used by Caddy, Gmail OAuth and Monobank webhooks.
DOMAIN=bot.example.com
PUBLIC_BASE_URL=https://bot.example.com
APP_PORT=8000
# Enables the containerized Caddy service on DigitalOcean.
# Do not add this on Hetzner when ports 80/443 are owned by an existing proxy.
COMPOSE_PROFILES=production

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional receipt recognition
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_TIMEOUT=60

# Application settings
PAGE_SIZE=7
CODE_COOLDOWN=30
CODE_MAX_AGE=180
TIMEZONE=Europe/Kyiv
